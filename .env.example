# Riotline Tool - configuration.
#
# Copy to .env and fill in. Real environment variables always win over this
# file, so a container can override anything here without editing it.

# ------------------------------------------------------------- accounts ---

# The first administrator, created on boot if that username does not exist.
#
# There is deliberately no "create the first account" page: a route that hands
# an admin account to whoever reaches it first is a race a stranger can win,
# and this server is meant to sit behind a tunnel. Whoever can set an
# environment variable already owns the machine, so that is the right place.
#
# It is NOT re-applied on later boots. Change the password in the dashboard,
# not here - otherwise a stale .env would silently undo it on every restart.
# Minimum 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Where operator state lives - graphics, accounts, uploaded media.
# Relative paths resolve against the application directory.
# STATE_DIR=.state

# Which addresses to listen on. 127.0.0.1 means this machine only, which is
# right for a laptop. A container must set 0.0.0.0 or the published port has
# nothing to forward to - the image does this for you.
# HOST=127.0.0.1

# Make the login cookie refuse to travel over plain HTTP. Right behind a
# tunnel or a TLS proxy; fatal on http://127.0.0.1, where a Secure cookie is
# silently dropped and nobody can sign in.
# COOKIE_SECURE=false

# ----------------------------------------------------------------- riot ---

RIOT_API_KEY=

# Platform routing for match + content endpoints.
RIOT_REGION=ap

# Regional routing for the account lookup.
RIOT_ROUTING=asia

# tracker.gg backup source - driven from the public website, NO API key.
# Needs a real browser: the site is Cloudflare-protected and loads its match
# list by XHR after render, so static fetching cannot see it.
#
#   npm run setup:tracker
#
# Then clear Cloudflare once by hand - the clearance is saved to the browser
# profile and reused headlessly afterwards:
#
#   npm run tracker:login
#
TRACKER_ENABLED=false

# Set to false to run the browser headed. Slower and it opens a window, but a
# headed browser passes Cloudflare checks that headless sometimes fails.
TRACKER_HEADLESS=true

# Which browser to drive: auto | chrome | chromium | msedge
# "auto" prefers real Google Chrome and falls back to Playwright's Chromium.
# Real Chrome is the most likely to pass Cloudflare, because it is the only one
# that reports a "Google Chrome" brand in its Sec-CH-UA client hints.
TRACKER_BROWSER_CHANNEL=auto

# How long to wait for the page and its XHRs, in milliseconds.
TRACKER_TIMEOUT_MS=45000

# HenrikDev key (default source) - free, via their Discord: https://discord.gg/henrikdev
# Unofficial VALORANT API. No production key needed and it returns custom games.
HENRIK_API_KEY=

# HenrikDev region: ap | br | eu | kr | latam | na
# Overridden automatically by the player's real region after lookup.
HENRIK_AFFINITY=ap

# HenrikDev platform: pc | console
HENRIK_PLATFORM=pc

# Which source the UI starts on: henrik | riot | tracker
DEFAULT_PROVIDER=tracker

# Local port for the UI.
PORT=8080

# ------------------------------------------------------ tracker viewer ---

# The in-app Cloudflare solve, served over noVNC. Both have working defaults;
# set them only if 6080 is taken or a solve needs longer than six minutes.
# TRACKER_LOGIN_PORT=6080
# TRACKER_LOGIN_TIMEOUT_MS=360000

# The Chromium profile holding the tracker.gg clearance. In a container this
# must be a subdirectory INSIDE a volume, never the mount point itself - the
# recovery from a poisoned clearance deletes and recreates this directory,
# and removing a mount point fails with EBUSY.
# PROFILE_DIR=.playwright-profile

# ------------------------------------------------------------- logging ---

# error | warn | info | debug
#
# `info` is the default and is what a show should produce: who signed in,
# what went on air, what the game feed said, and anything that failed.
# `debug` is the verbose mode - every request with its timing, every event
# stream opening and closing, every roster event.
#
# An administrator can change this at runtime from the Admin tab, which is
# the point: the moment you want verbose output is the moment you cannot
# afford to restart and take every graphic off air.
#
# Session keys, passwords and cookies are never written to the log at any
# level - see redact() in log.js.
# LOG_LEVEL=info

# How many lines the Admin tab can look back over. In memory only; anything
# older is in `docker logs`.
# LOG_BUFFER=500
